{
  "schema_version": 1,
  "policy": "One shared causal match path generates all team, player and timeline events. No separately invented outcomes or independent event overlays.",
  "pre_match_as_of": "All model features, registrations, injuries, prices and calibration parameters must have timestamps earlier than kickoff; same-day match results are forbidden unless verifiably completed before the fixture's kickoff.",
  "primary_published_window_minutes": 15,
  "internal_clock_seconds": 1,
  "minimum_independent_paths_for_public_result_probability": 2500,
  "max_binomial_mc_halfwidth_at_p50_for_public_result_probability": 0.0196,
  "minimum_distinct_oos_matches_for_release": 200,
  "release_policy": "Strict prospective evaluation of this model family on held-out, matchday-grouped fixtures. Beat previous-only empirical reference in a proper scoring rule; matchday bootstrap uncertainty must support the improvement. Coverage and result/shot/scorer identities must be checked. If unavailable, status is research_only, not calibrated.",
  "targets": [
    {
      "id": "match_wdl",
      "level": "match",
      "priority": "P0",
      "kind": "categorical_distribution",
      "choices": [
        "home_win",
        "draw",
        "away_win"
      ],
      "primary_score": "multiclass_log_loss",
      "secondary_score": "multiclass_brier",
      "baseline": "causal_league_team_strength",
      "label": "final_home_away_goals",
      "required_events": "final_scores",
      "release": "research_only"
    },
    {
      "id": "match_exact_score",
      "level": "match",
      "priority": "P0",
      "kind": "joint_count_distribution",
      "values": "home_goals_x_away_goals",
      "primary_score": "joint_log_loss",
      "secondary_score": "ranked_probability_score",
      "baseline": "causal_independent_poisson",
      "label": "full_time_score",
      "required_events": "final_scores",
      "release": "not_in_simulator"
    },
    {
      "id": "match_total_goals_btts",
      "level": "match",
      "priority": "P1",
      "kind": "derived_joint_distribution",
      "values": "total_goals_over_under_btts",
      "primary_score": "binary_brier_and_log_loss",
      "baseline": "score_distribution_baseline",
      "label": "full_time_score",
      "required_events": "final_scores",
      "release": "not_in_simulator"
    },
    {
      "id": "team_goals",
      "level": "team",
      "priority": "P0",
      "kind": "count_distribution",
      "primary_score": "discrete_crps",
      "secondary_score": "count_mae",
      "baseline": "previous_only_team_goal_rate",
      "label": "team_full_time_goal_count",
      "required_events": "final_scores",
      "release": "research_only"
    },
    {
      "id": "team_shots_and_sot",
      "level": "team",
      "priority": "P1",
      "kind": "count_distribution",
      "primary_score": "count_log_loss",
      "secondary_score": "count_mae",
      "baseline": "previous_only_team_shots_and_sot",
      "label": "full_match_shots_and_sot",

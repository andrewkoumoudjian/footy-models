    },
    {
      "id": "player_appearance_minutes",
      "level": "player",
      "priority": "P0",
      "kind": "appearance_probability_and_minutes_distribution",
      "primary_score": "appearance_brier_plus_minutes_mae",
      "baseline": "causal_start_minutes_last_n",
      "label": "official_lineup_and_actual_minutes",
      "required_events": "dated_team_lineups",
      "release": "research_only"
    },
    {
      "id": "player_shots_sot",
      "level": "player",
      "priority": "P1",
